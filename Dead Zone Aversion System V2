def CreateRoute(RobotStartingPoint, RobotGoalPoint):
    RoutePoints = []
    RouteFinished = False
    FinalizedRoute = []
    
    RoutePoints.append(RobotStartingPoint)

    while RouteFinished == False:
        RouteAddOn = AddOnRoute(RoutePoints[-1], RobotGoalPoint)
        if RouteAddOn == True:
            RouteFinished = True
        else:
            RoutePoints.append(RouteAddOn)

    RoutePoints.append(RobotGoalPoint)

    FinalizedRoute = CalculateTotalRoute(RoutePoints)
    return FinalizedRoute

