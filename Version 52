def SpinLeftMotorsSetDist(Amount, Velocity):

    
    LeftMotorGroup.set_velocity(abs(Velocity), PERCENT)
    
    if Velocity >= 0:
        Direction = REVERSE #Swapped Because Motors Are Flipped Between Both Sides
    if Velocity < 0:
        Direction = FORWARD #Swapped Because Motors Are Flipped Between Both Sides

    LeftMotorGroup.spin_for(Direction, Amount, DEGREES)

def SpinRightMotorsSetDist(Amount, Velocity):
                

    RightMotorGroup.set_velocity(abs(Velocity), PERCENT)
    
    if Velocity >= 0:
        Direction = REVERSE
    if Velocity < 0:
        Direction = FORWARD

    RightMotorGroup.spin_for(Direction, Amount, DEGREES)


def ConvertToTicks(WheelDiameter, Distance):
    Ticks = (Distance / ((WheelDiameter * 25.4) * math.pi)) * 360
    return Ticks


def SpinLeftMotorsUntil(Velocity):

    LeftMotorGroup.set_velocity(abs(Velocity), PERCENT)
    
    if Velocity >= 0:
        Direction = FORWARD
    if Velocity < 0:
        Direction = REVERSE

    LeftMotorGroup.spin(Direction)

def SpinRightMotorsUntil(Velocity):

    RightMotorGroup.set_velocity(abs(Velocity), PERCENT)
    
    if (-1 * Velocity) >= 0:
        Direction = FORWARD
    if (-1 * Velocity) < 0:
        Direction = REVERSE

    RightMotorGroup.spin(Direction)

def StopLeftMotors():
    LeftMotorGroup.stop()

def StopRightMotors():
    RightMotorGroup.stop()

def FindJoystickVelocity(JoystickPosition, NumberToRoundTo, Precision):
    return int((NumberToRoundTo*(round((JoystickPosition) / NumberToRoundTo))) / Precision)



