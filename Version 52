#PID


def CalculateError(CurrentError, TargetError):
    return TargetError - CurrentError

def GetRoateDegreesValue(DistanceToRotate):
    return CalculateRobotRotation() + DistanceToRotate

def CalculateMotorRotation():
    return ((LeftMotorGroup.position(DEGREES) + RightMotorGroup.position(DEGREES)) / 2)

def CalculateRobotRotation():
    return InertialSensor.heading(DEGREES)

def CalculateLoopedRotationalError(Error):
    if Error > 180:
        return -180 + (Error - 180)
    elif Error < -180:
        return 180 + (Error + 180)
    else:
        return Error



def CalculatePID(Error, SumOfPastErrors, PastError, PID, StartI):

    P = PID.P * Error
    
    if abs(Error) < StartI:
        I = PID.I * SumOfPastErrors
    else:
        I = 0

    D = PID.D * (Error - PastError)

    
    Output = (P) + (I) + (D)

    if Output > 100:
        Output = 100
    elif Output < -100:
        Output = -100

    return Output

def IsSettled(TimeSpentRunning, Timeout, TimeSpentSettled, SettleTime):
    if (TimeSpentRunning > Timeout and Timeout != 0):
        return(True)
    if (TimeSpentSettled > SettleTime):
        return(True)
  
    return(False)

def LinearPID(ErrorToTargetError, PID):
    global WheelDiameter
    global GearRatio
    global DegreesToInchesRatio

    LinearPIDValues = PID
    MinimumError = 1.2 #Settle Error

    RightInches = LeftMotorGroup.position(DEGREES) * DegreesToInchesRatio
    LeftInches  = LeftMotorGroup.position(DEGREES) * DegreesToInchesRatio

    ErrorToTargetError = ErrorToTargetError * DegreesToInchesRatio
    RunTimeDelay = 20
    CurrentError = (RightInches + LeftInches) / 2
    TargetError = CurrentError + ErrorToTargetError
    StartingError = CalculateMotorRotation()
    SumOfPastErrors = 0
    PastError = 0
    Error = 0
    
    BeganSettling = False
    IsItSettled = False
    SettleTime = 2000
    Timeout = 5500

    Runtime = 0
    TimeSettled = 0
    StartI = 5

    while IsItSettled == False:

        RightInches = LeftMotorGroup.position(DEGREES) * DegreesToInchesRatio
        LeftInches  = LeftMotorGroup.position(DEGREES) * DegreesToInchesRatio

        PastError = Error
        CurrentError = (RightInches + LeftInches) / 2

        if -1* MinimumError < Error < MinimumError:
            BeganSettling = True

        #Error = CalculateError(CurrentError, TargetError)
        Error = TargetError - CurrentError

        if abs(Error) < StartI:
            SumOfPastErrors += Error
        else:
            SumOfPastErrors = 0

        Output = CalculatePID(Error, SumOfPastErrors, PastError, LinearPIDValues, StartI)
        
        LeftMotorGroup.set_velocity((Output), PERCENT) 
        RightMotorGroup.set_velocity((Output), PERCENT) 

        LeftMotorGroup.spin(FORWARD)
        RightMotorGroup.spin(REVERSE)

        controller_1.screen.clear_screen()
        controller_1.screen.set_cursor(1,1)
        controller_1.screen.print(Error)
        controller_1.screen.set_cursor(3,1)
        controller_1.screen.print(CalculateMotorRotation())    

        IsItSettled = IsSettled(Runtime, Timeout, TimeSettled, SettleTime)

        if BeganSettling:
            TimeSettled += RunTimeDelay

        Runtime += RunTimeDelay
        wait(RunTimeDelay, MSEC)

    LeftMotorGroup.stop()
    RightMotorGroup.stop()
    


def RotationalPID(Target, PID):
    
    RotationalPIDValues = PID
    MinimumError = 2.5 #Settle Error
    
    RunTimeDelay = 20
    Error = -1 * (Target - CalculateRobotRotation())
    StartingError = Error
    SumOfPastErrors = 0
    PastError = 0
    
    BeganSettling = False
    IsItSettled = False
    SettleTime = 2300
    Timeout = 3900

    Runtime = 0
    TimeSettled = 0
    StartI = 6

    while IsItSettled == False:

        PastError = Error
        
        Error = -1 * (Target - CalculateRobotRotation())

        if -1* MinimumError < Error < MinimumError:
            BeganSettling = True

        if abs(Error) < StartI:
            SumOfPastErrors += Error
        else:
            SumOfPastErrors = 0

        Output = -1 * (CalculatePID(Error, SumOfPastErrors, PastError, RotationalPIDValues, StartI))

        LeftMotorGroup.set_velocity(Output, PERCENT)
        RightMotorGroup.set_velocity(-1 * Output, PERCENT) 

        LeftMotorGroup.spin(FORWARD)
        RightMotorGroup.spin(REVERSE)

        controller_1.screen.clear_screen()
        controller_1.screen.set_cursor(1,1)
        controller_1.screen.print(Error)
        controller_1.screen.set_cursor(3,1)
        controller_1.screen.print(InertialSensor.heading(DEGREES))  

        IsItSettled = IsSettled(Runtime, Timeout, TimeSettled, SettleTime)

        if BeganSettling:
            TimeSettled += RunTimeDelay

        Runtime += RunTimeDelay
        wait(RunTimeDelay, MSEC)

    LeftMotorGroup.stop()
    RightMotorGroup.stop()


