WheelDiameter = 3.25


def CalculateError(CurrentError, TargetError):
    return TargetError - CurrentError

def CalculateMotorRotation():
    return (LeftMotorGroup.position(DEGREES) + RightMotorGroup.position(DEGREES)) / 2


def CalculatePID(Error, SumOfPastErrors, PastError, PID, StartI):

    P = PID.P * Error
    
    if abs(Error) < StartI:
        I = PID.I * SumOfPastErrors
    else:
        I = 0

    D = PID.D * (Error - PastError)

    
    Output = (P) + (I) + (D)

    if Output > 100:
        Output = 100
    elif Output < -100:
        Output = -100

    return Output

def IsSettled(TimeSpentRunning, Timeout, TimeSpentSettled, SettleTime):
    if (TimeSpentRunning > Timeout and Timeout != 0):
        return(True)
    if (TimeSpentSettled > SettleTime):
        return(True)
  
    return(False)

def LinearPID(ErrorToTargetError):
    
    global LinearPIDValues
    MinimumError = 1.2 #Settle Error
    
    RunTimeDelay = 0.02
    TargetError = CalculateMotorRotation() + ErrorToTargetError
    CurrentError = CalculateMotorRotation()
    StartingError = CalculateMotorRotation()
    SumOfPastErrors = 0
    PastError = 0
    Error = 0
    
    BeganSettling = False
    IsItSettled = False
    SettleTime = 2000
    Timeout = 5500

    Runtime = 0
    TimeSettled = 0
    StartI = 5

    while IsItSettled == False:

        SumOfPastErrors += Error
        PastError = Error
        CurrentError = CalculateMotorRotation() 

        if -1* MinimumError < Error < MinimumError:
            BeganSettling = True

        Error = CalculateError(CurrentError, TargetError)
        Output = CalculatePID(Error, SumOfPastErrors, PastError, LinearPID, StartI)
        
        LeftMotorGroup.set_velocity(Output, PERCENT) 
        RightMotorGroup.set_velocity(Output, PERCENT) 

        IsItSettled = IsSettled(Runtime, Timeout, TimeSettled, SettleTime)

        if BeganSettling:
            TimeSettled += RunTimeDelay

        Runtime += RunTimeDelay
    


def RotationalPID(ErrorToTargetError):
    
    global RotationalPIDValues
    MinimumError = 2.5 #Settle Error
    
    RunTimeDelay = 0.02
    TargetError = CalculateMotorRotation() + ErrorToTargetError
    CurrentError = CalculateMotorRotation()
    StartingError = CalculateMotorRotation()
    SumOfPastErrors = 0
    PastError = 0
    Error = 0
    
    BeganSettling = False
    IsItSettled = False
    SettleTime = 2300
    Timeout = 3900

    Runtime = 0
    TimeSettled = 0
    StartI = 6

    while IsItSettled == False:

        SumOfPastErrors += Error
        PastError = Error
        CurrentError = CalculateMotorRotation()

        if -1* MinimumError < Error < MinimumError:
            BeganSettling = True

        Error = CalculateError(CurrentError, TargetError)
        Output = CalculatePID(Error, SumOfPastErrors, PastError, RotationalPID, StartI)

        LeftMotorGroup.set_velocity(Output, PERCENT) 
        RightMotorGroup.set_velocity(-1*Output, PERCENT) 

        IsItSettled = IsSettled(Runtime, Timeout, TimeSettled, SettleTime)

        if BeganSettling:
            TimeSettled += RunTimeDelay

        Runtime += RunTimeDelay


