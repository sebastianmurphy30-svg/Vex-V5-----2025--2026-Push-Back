#Auton Functions:
def Rotate(DegreesToRotate):
    global WheelDiameter
    
    LengthOfRobot = 457.2
    RotationCircle = 2*math.pi*(LengthOfRobot/2)
    Multiplier = DegreesToRotate / 360
    CircumfrenceOfWheels = 2 * math.pi * WheelDiameter
    WheelDegreeChangeOutput = (Multiplier * RotationCircle) / (CircumfrenceOfWheels / 360)
    
    LeftMotorGroup.spin(FORWARD)
    RightMotorGroup.spin(FORWARD)
    RotationalPID(WheelDegreeChangeOutput)
    

def Drive(DistanceToDrive):
    global WheelDiameter
    
    CircumfrenceOfWheels = 2 * math.pi * WheelDiameter
    WheelDegreeChangeOutput = DistanceToDrive / (CircumfrenceOfWheels / 360)

    LeftMotorGroup.spin(FORWARD)
    RightMotorGroup.spin(FORWARD)
    LinearPID(WheelDegreeChangeOutput)

