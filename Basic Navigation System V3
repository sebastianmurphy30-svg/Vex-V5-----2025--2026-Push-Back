        DistancesOfTarget.append(math.sqrt(DistancesOfTargetX ** 2 + DistancesOfTargetY ** 2))

    Target = PointAndDistance(PositionsOfObjects[DistancesOfTarget.index(min(DistancesOfTarget))], PositionsOfObjects[DistancesOfTarget.index(min(DistancesOfTarget))], min(DistancesOfTarget))
    return Target

