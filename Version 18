def SpinLeftMotorsSetDist(Amount, Unit, Velocity):
        
    FrontLeftMotor.set_velocity(abs(Velocity), PERCENT)
    BackLeftMotor.set_velocity(abs(Velocity), PERCENT)
    
    if Velocity >= 0:
        Direction = REVERSE #Swapped Because Motors Are Flipped Between Both Sides
    if Velocity < 0:
        Direction = FORWARD #Swapped Because Motors Are Flipped Between Both Sides

    FrontLeftMotor.spin_for(Direction, Amount, Unit)
    BackLeftMotor.spin_for(Direction, Amount, Unit)

def SpinRightMotorsSetDist(Amount, Unit, Velocity):
        
    FrontRightMotor.set_velocity(abs(Velocity), PERCENT)
    BackRightMotor.set_velocity(abs(Velocity), PERCENT)
    
    if Velocity >= 0:
        Direction = FORWARD
    if Velocity < 0:
        Direction = REVERSE

    FrontRightMotor.spin_for(Direction, Amount, Unit)
    BackRightMotor.spin_for(Direction, Amount, Unit)


def SpinLeftMotorsUntil(Velocity):

    FrontLeftMotor.set_velocity(abs(Velocity), PERCENT)
    BackLeftMotor.set_velocity(abs(Velocity), PERCENT)
    
    if Velocity >= 0:
        Direction = FORWARD
    if Velocity < 0:
        Direction = REVERSE

    FrontLeftMotor.spin(Direction)
    BackLeftMotor.spin(Direction)

def SpinRightMotorsUntil(Velocity):
        
    FrontRightMotor.set_velocity(abs(Velocity), PERCENT)
    BackRightMotor.set_velocity(abs(Velocity), PERCENT)
    
    if Velocity >= 0:
        Direction = REVERSE #Swapped Because Motors Are Flipped Between Both Sides
    if Velocity < 0:
        Direction = FORWARD #Swapped Because Motors Are Flipped Between Both Sides

    FrontRightMotor.spin(Direction)
    BackRightMotor.spin(Direction)

def StopLeftMotors():
    FrontLeftMotor.stop()
    BackLeftMotor.stop()

def StopRightMotors():
    FrontRightMotor.stop()
    BackRightMotor.stop()

def FindJoystickVelocity(JoystickPosition, NumberToRoundTo, Precision):
    return int((NumberToRoundTo*(round((JoystickPosition) / NumberToRoundTo))) / Precision)



#G

def SelectNormalDriveMode():
    global DriveModeSelected
    DriveModeSelected = "Normal"
def SelectRotationalDriveMode():
    global DriveModeSelected
    DriveModeSelected = "Rotational"
def SelectLinearDriveMode():
    global DriveModeSelected
    DriveModeSelected = "Linear"

    global ModeSelected
    ModeSelected = "Precise"

def SwitchBetweenNormalAndPreciseMode():
    global ModeSelected
    
    if ModeSelected == "Normal":
        ModeSelected = "Precise"

    if ModeSelected == "Precise":
        ModeSelected = "Normal"

#G

def NormalDrive(NumberToRoundTo, Precision):
    LeftSideVelocity = FindJoystickVelocity(controller_1.axis3.position(), NumberToRoundTo, Precision)
    RightSideVelocity = FindJoystickVelocity(controller_1.axis2.position(), NumberToRoundTo, Precision)

    if LeftSideVelocity != 0 or RightSideVelocity != 0:
        SpinLeftMotorsUntil(LeftSideVelocity)
        SpinRightMotorsUntil(RightSideVelocity)

    if RightSideVelocity == 0 and LeftSideVelocity == 0:
        StopLeftMotors()
        StopRightMotors()

def RotationDrive(NumberToRoundTo, Precision):
    LeftSideVelocity = FindJoystickVelocity(controller_1.axis3.position(), NumberToRoundTo, Precision)
    RightSideVelocity = FindJoystickVelocity(controller_1.axis2.position(), NumberToRoundTo, Precision)

    RotationalVelocity = abs((LeftSideVelocity / 2) + (RightSideVelocity / 2))

    if RotationalVelocity != 0 and LeftSideVelocity > RightSideVelocity:
        SpinLeftMotorsUntil(RotationalVelocity)
        SpinRightMotorsUntil(-1 * (RotationalVelocity))

    if RotationalVelocity != 0 and RightSideVelocity > LeftSideVelocity:

        SpinRightMotorsUntil(RotationalVelocity)
        SpinLeftMotorsUntil(-1 * (RotationalVelocity))

    if RotationalVelocity == 0:
        StopLeftMotors()
        StopRightMotors()

def LinearDrive(NumberToRoundTo, Precision): 

    LinearVelocity = 0
    LeftSideVelocity = FindJoystickVelocity(controller_1.axis3.position(), NumberToRoundTo, Precision)
    RightSideVelocity = FindJoystickVelocity(controller_1.axis2.position(), NumberToRoundTo, Precision)

    LinearVelocity = (LeftSideVelocity + RightSideVelocity) / 2

    if LinearVelocity != 0:
        SpinLeftMotorsUntil(LinearVelocity)
        SpinRightMotorsUntil(LinearVelocity)

    if LinearVelocity == 0:
        StopLeftMotors()
        StopRightMotors()



